; Engine configuration file.
config_version=5

[application]

config/name="TheFrontier"
config/description="First-person sci-fi shooter and core-defense prototype."
config/version="0.1.0"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameSettings="*res://scripts/autoload/game_settings.gd"
GameBus="*res://scripts/autoload/game_bus.gd"
InputBindings="*res://scripts/autoload/input_bindings.gd"
Session="*res://scripts/autoload/session.gd"
Sfx="*res://scripts/autoload/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="player"
3d_physics/layer_3="mobs"
3d_physics/layer_4="buildings"
3d_physics/layer_5="projectiles"
3d_physics/layer_6="core"
3d_physics/layer_7="resources"

[debug]

gdscript/warnings/inferred_declaration=1
gdscript/warnings/untyped_declaration=1
gdscript/warnings/unsafe_method_access=1
gdscript/warnings/unsafe_property_access=1
gdscript/warnings/unsafe_cast=1

[physics]

3d/default_gravity=18.0

[rendering]

renderer/rendering_method="forward_plus"
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.08, 1)
